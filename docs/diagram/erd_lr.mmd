erDiagram
  %% Urutan kolom sengaja ditulis "nama_atribut tipe_data kunci" agar gambar menampilkan
  %% kolom Nama Atribut | Tipe Data | PK/FK/UK (sintaks asli Mermaid: tipe nama kunci).
  direction LR
  PENGGUNA ||--o| CALON_MURID : "mendaftarkan"
  CALON_MURID ||--|{ ORANG_TUA_WALI : "memiliki"
  CALON_MURID ||--o{ PENDAFTARAN : "mengikuti"
  PERIODE_SPMB ||--o{ PENDAFTARAN : "menampung"
  PERIODE_SPMB ||--|{ KUOTA_JALUR : "membagi"
  PENDAFTARAN ||--o{ DOKUMEN : "melampirkan"
  JENIS_DOKUMEN ||--o{ DOKUMEN : "mengategorikan"
  JENIS_DOKUMEN ||--o{ PERSYARATAN_JALUR : "disyaratkan"
  PENDAFTARAN ||--o{ RIWAYAT_STATUS : "dicatat"
  PENGGUNA ||--o{ RIWAYAT_STATUS : "mengubah"
  PENGGUNA {
    id int PK
    nama varchar
    username varchar UK
    email varchar UK
    no_hp varchar
    password_hash varchar
    peran enum
    aktif bool
    dibuat_pada timestamptz
  }
  CALON_MURID {
    id int PK
    pengguna_id int FK
    nik char UK
    nisn char
    nama_lengkap varchar
    jenis_kelamin enum
    tempat_lahir varchar
    tanggal_lahir date
    no_akta_lahir varchar
    agama varchar
    kewarganegaraan varchar
    alamat varchar
    rt char
    rw char
    kelurahan varchar
    kecamatan varchar
    kode_pos char
    patokan_rumah varchar
    tempat_tinggal varchar
    moda_transportasi varchar
    no_kk char
    tgl_terbit_kk date
    jarak_ke_sekolah_km numeric
    anak_ke smallint
    jumlah_saudara smallint
    no_kks varchar
    penerima_pkh bool
    no_kip varchar
    no_kis_pbi varchar
    tinggi_badan_cm smallint
    berat_badan_kg numeric
    waktu_ke_sekolah_menit smallint
    berkebutuhan_khusus bool
    dibuat_pada timestamptz
    diubah_pada timestamptz
  }
  ORANG_TUA_WALI {
    id int PK
    calon_murid_id int FK
    hubungan enum
    nama varchar
    nik char
    tahun_lahir smallint
    pendidikan varchar
    pekerjaan varchar
    penghasilan varchar
    no_hp varchar
  }
  PENDAFTARAN {
    id int PK
    nomor_pendaftaran varchar UK
    calon_murid_id int FK
    periode_id int FK
    jalur enum
    status enum
    usia_bulan smallint
    perlu_rekomendasi_psikolog bool
    catatan_panitia text
    peringkat smallint
    diajukan_pada timestamptz
    daftar_ulang_pada timestamptz
    dibuat_pada timestamptz
    diubah_pada timestamptz
  }
  PERIODE_SPMB {
    id int PK
    tahun_ajaran varchar UK
    tgl_mulai_daftar date
    tgl_selesai_daftar date
    tgl_pengumuman date
    tgl_daftar_ulang_mulai date
    tgl_daftar_ulang_selesai date
    tgl_acuan_usia date
    jumlah_rombel smallint
    murid_per_rombel smallint
    daya_tampung smallint
    aktif bool
    seleksi_diproses_pada timestamptz
    hasil_diumumkan bool
  }
  KUOTA_JALUR {
    id int PK
    periode_id int FK
    jalur enum
    persen numeric
  }
  DOKUMEN {
    id int PK
    pendaftaran_id int FK
    jenis_dokumen_id int FK
    nama_file_asli varchar
    path_file varchar
    tipe_mime varchar
    ukuran_byte int
    status_verifikasi enum
    catatan text
    diunggah_pada timestamptz
  }
  JENIS_DOKUMEN {
    id int PK
    kode varchar UK
    nama varchar
  }
  PERSYARATAN_JALUR {
    jalur enum PK
    jenis_dokumen_id int PK,FK
    wajib bool
  }
  RIWAYAT_STATUS {
    id bigint PK
    pendaftaran_id int FK
    status_lama enum
    status_baru enum
    oleh_pengguna_id int FK
    catatan text
    waktu timestamptz
  }
